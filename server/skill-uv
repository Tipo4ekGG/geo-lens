#!/usr/bin/env python3
"""Child-script adapter: dependencies are preinstalled in the tool image."""
import os,sys
from pathlib import Path
args=sys.argv[1:]
if len(args)<2 or args[0]!='run':
 raise SystemExit('Only uv run <bundled-script.py> is supported by the image adapter')
script=Path(args[1]).resolve()
if script.parent!=Path('/opt/skill/scripts') or not script.is_file():
 raise SystemExit('Only bundled skill scripts can run')
os.execv(sys.executable,[sys.executable,str(script),*args[2:]])
